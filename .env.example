# Copy this file to .env and fill in the values. Never commit .env.

# --- Website (safe to expose: read-only) ---
# Supabase > Project Settings > API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Agents and scripts (secret: keep private) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Leave blank to run agents on your Claude subscription (run `claude` once to sign in).
# Or paste an API key from console.anthropic.com to pay per use instead.
ANTHROPIC_API_KEY=

# Spending cap per agent run, in US dollars (only applies when using an API key)
MAX_USD_PER_RUN=1
