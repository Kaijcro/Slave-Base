# Copy this file to .env and fill in the values. Never commit .env.

# --- Website (safe to expose: read-only) ---
# Supabase > Project Settings > API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Agents and scripts (secret: keep private) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Leave blank to run agents on your Claude subscription (run `claude` once to sign in).
# Or paste an API key from console.anthropic.com to pay per use instead.
ANTHROPIC_API_KEY=

# Optional: a long-lasting subscription login for scripts. Get one with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Spending cap per agent run, in US dollars (only applies when using an API key)
MAX_USD_PER_RUN=1

# Town runner (npm run town): how many agents may work at once, and the step limit per prompt.
# On a Pro plan, 2 at a time is a good balance; raise it on Max.
MAX_PARALLEL=2
MAX_TURNS=30

# --- AI Enterprizes Etsy shop (see README) ---
# Etsy: etsy.com/developers > Your apps > your app's keystring and shared secret. Then run: npm run etsy-login
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Printify: My account > Connections > Generate token. Connect your Etsy shop in Printify too.
PRINTIFY_API_TOKEN=
# Publish new listings automatically (true) or save them as drafts for you (false), and the most per day.
SHOP_AUTO_PUBLISH=true
SHOP_DAILY_LIMIT=5
