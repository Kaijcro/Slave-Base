# Copy this file to .env and fill in the values. Never commit .env.

# --- Website (safe to expose: read-only) ---
# Supabase > Project Settings > API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Agents and scripts (secret: keep private) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Leave blank to run agents on your Claude subscription (run `claude` once to sign in).
# Or paste an API key from console.anthropic.com to pay per use instead.
ANTHROPIC_API_KEY=

# Optional: a long-lasting subscription login for scripts. Get one with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Spending cap per agent run, in US dollars (only applies when using an API key)
MAX_USD_PER_RUN=1

# Town runner (npm run town): how many agents may work at once, and the step limit per prompt.
# On a Pro plan, 2 at a time is a good balance; raise it on Max.
MAX_PARALLEL=2
MAX_TURNS=30

# --- AI Enterprizes Etsy shop (see README) ---
# Etsy: etsy.com/developers > Your apps > your app's keystring and shared secret. Then run: npm run etsy-login
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Printify: My account > Connections > Generate token. Connect your Etsy shop in Printify too.
PRINTIFY_API_TOKEN=
# Publish new listings automatically (true) or save them as drafts for you (false), and the most per day.
SHOP_AUTO_PUBLISH=true
SHOP_DAILY_LIMIT=5

# --- AI receptionist business (Retell AI, see README) ---
# Retell dashboard > Settings > API Keys. Buy demo numbers in Retell and nickname them "Demo 1", "Demo 2"...
RETELL_API_KEY=
# Optional: a voice id from Retell (blank = a standard female voice) and the model the receptionist thinks with.
RETELL_VOICE_ID=
RETELL_MODEL=gpt-4.1
# Which agents get the receptionist tools (ids from src/world/agents.ts).
VOICE_AGENTS=priya,kofi,dex

# --- Prospects, cold email and client reports (see README, "Prospects and outreach") ---
# Google Cloud > APIs & Services > enable "Places API (New)" > Credentials > API key.
GOOGLE_PLACES_API_KEY=
# Google gives 1,000 detailed searches free a month; the runner stops at this many.
GOOGLE_PLACES_MONTHLY_LIMIT=900
# Instantly > Settings > Integrations > API keys. Campaigns only send after you approve them.
INSTANTLY_API_KEY=
# Optional: which connected inboxes send (comma-separated). Blank = all of them.
INSTANTLY_SENDING_ACCOUNTS=
# Sending window, Monday to Friday. America/Detroit is US Eastern in Instantly's list.
INSTANTLY_TIMEZONE=America/Detroit
INSTANTLY_SEND_FROM=08:00
INSTANTLY_SEND_TO=17:00
# The name at the top of client reports (your receptionist business).
REPORT_BUSINESS_NAME=

# --- Google Drive: your agents' work as Google Docs and Sheets (see README, "Google Drive") ---
# Google Cloud > Google Auth Platform > Clients > Create client > Desktop app. Then run: npm run google-login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The folder name in your Drive.
GOOGLE_DRIVE_FOLDER=Slave Base
